---
const name = '你的名字';
const tagline = '一句話介紹你自己。';
const links = [
  { label: 'GitHub', href: 'https://github.com/acheeeee' },
  { label: 'Email', href: 'mailto:ach3r204@gmail.com' },
];
---

<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={tagline} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{name}</title>
  </head>
  <body>
    <main>
      <h1>{name}</h1>
      <p class="tagline">{tagline}</p>

      <nav aria-label="聯絡方式">
        <ul>
          {links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </main>

    <style>
      :root {
        color-scheme: light dark;
        --fg: #16181d;
        --fg-muted: #5c6270;
        --bg: #fdfdfc;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --fg: #f2f3f5;
          --fg-muted: #a2a8b4;
          --bg: #121316;
        }
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: 2rem;
        background: var(--bg);
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, 'Helvetica Neue',
          'PingFang TC', 'Noto Sans TC', sans-serif;
        line-height: 1.6;
      }

      main {
        width: 100%;
        max-width: 34rem;
      }

      h1 {
        margin: 0 0 0.5rem;
        font-size: clamp(2rem, 6vw, 3rem);
        letter-spacing: -0.02em;
      }

      .tagline {
        margin: 0 0 2rem;
        color: var(--fg-muted);
      }

      nav ul {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      a {
        color: var(--fg);
        text-decoration-color: var(--fg-muted);
        text-underline-offset: 0.25em;
      }

      a:hover {
        text-decoration-color: currentColor;
      }

      a:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 3px;
        border-radius: 2px;
      }
    </style>
  </body>
</html>
