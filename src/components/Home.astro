<script>
  // 滑鼠滾輪捲動頁面：滾輪的上下轉成左右，整頁任何位置（包括頂部列）都有效。
  // 用目標值加 rAF 補間，讓一格一格的滾輪變成平滑移動而不是一跳一跳。
  const track = document.getElementById('track');

  if (track) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let target = track.scrollLeft;
    let raf = 0;

    const maxLeft = () => track.scrollWidth - track.clientWidth;

    const step = () => {
      const diff = target - track.scrollLeft;
      if (Math.abs(diff) < 0.5) {
        track.scrollLeft = target;
        raf = 0;
        return;
      }
      track.scrollLeft += diff * 0.18;
      raf = requestAnimationFrame(step);
    };

    // 全部格子一起縮放：scrollLeft 在 0 時最大，往右捲動「第一格寬度」的距離內線性降到 REST_ZOOM。
    // 最大值通常是 1.2，但矮螢幕上下留白不夠、或手機左右放不下時會自動縮小，避免被切掉。
    // 桌機與手機都有（使用者要求手機滑動也要縮放）；只有「減少動態」設定下關閉。
    const introCol = document.getElementById('intro-col');
    /** 往右捲動後的大小（使用者要求：原本大小的 85%） */
    const REST_ZOOM = 0.85;
    /** 縮小速度倍率（1 = 捲完一個第一格寬度才縮完；1.25 = 快 1.25 倍） */
    const SHRINK_SPEED = 1.25;
    const updateZoom = () => {
      if (reduce || !introCol) {
        track.style.setProperty('--track-zoom', '1');
        return;
      }
      const current = parseFloat(track.style.getPropertyValue('--track-zoom')) || 1;
      const cs = getComputedStyle(track);
      const inner = track.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
      // 格子往上下平均長大，所以可用空間看比較窄的那一邊（置中後上面的留白比下面少）
      const room = inner + 2 * Math.min(parseFloat(cs.paddingTop), parseFloat(cs.paddingBottom)) - 8; // 留一點，hover 放大時才不會碰到邊
      // 第一格原本的寬度（目前寬度 ÷ 目前倍率）
      const baseW = introCol.getBoundingClientRect().width / current;
      // 左右上限：放大後第一格仍要完整放在螢幕內（手機的欄接近滿寬，這條才會起作用）
      const roomW = track.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      const maxZoom = Math.max(1, Math.min(1.2, room / Math.max(inner, 1), roomW / Math.max(baseW, 1)));
      // 縮放的距離以「第一格原本的寬度」為準
      // 使用者要求縮小速度快約 1.25 倍：縮小所需的捲動距離除以 SHRINK_SPEED
      const range = baseW / SHRINK_SPEED;
      const progress = Math.min(Math.max(track.scrollLeft / Math.max(range, 1), 0), 1);
      const zoom = maxZoom - (maxZoom - REST_ZOOM) * progress;
      if (Math.abs(zoom - current) > 0.0005) track.style.setProperty('--track-zoom', zoom.toFixed(4));
    };
    track.addEventListener('scroll', updateZoom, { passive: true });
    window.addEventListener('resize', updateZoom);
    updateZoom();

    // 空白格裡的狗：格子在畫面上越往左，狗在格子裡越往右（方向與捲動相反）。
    // 進度 = 格子從右邊進場到從左邊離場走了多少：剛露出來 0、正要離開 1。
    // 這格靠近軌道尾端，捲到底時還沒離開畫面，所以「離開」以捲到底和真的離開兩者先到的為準，狗才走得到最右邊。
    // 狗在移動時一上一下（跑步），前面的球一下一下彈地；停下來後慢慢停住。
    // 「減少動態」設定下狗停在中間、球靜止，都不動。
    const dogs = [...document.querySelectorAll<HTMLElement>('.dogrun')];
    const motion = new Map<HTMLElement, { p: number; dist: number; phase: number; ballPhase: number; run: number; bounce: number }>();
    let motionRaf = 0;
    let lastT = 0;
    const stepMotion = (t: number) => {
      const dt = lastT ? Math.min((t - lastT) / 1000, 0.05) : 0.016;
      lastT = t;
      let alive = false;
      for (const [run, m] of motion) {
        const dogH = run.querySelector<HTMLElement>('.dogrun__dog')?.getBoundingClientRect().height || 1;
        const speed = m.dist / Math.max(dt, 0.001) / dogH;      // 每秒跑幾個狗身高
        m.run = Math.max(Math.min(speed / 3, 1), m.run - dt * 2.5);
        m.bounce = Math.max(m.run, m.bounce - dt * 0.9);         // 球比狗晚一點停
        m.phase += (m.dist / dogH) * Math.PI * 2.2;               // 跑的步伐跟著移動距離走
        m.ballPhase += dt * Math.PI * 2 * 1.5 * (0.4 + 0.6 * m.bounce);
        m.dist = 0;
        const bob = Math.round(Math.abs(Math.sin(m.phase)) * 2 * Math.min(1, m.run * 3));
        const h = Math.abs(Math.sin(m.ballPhase));
        const ballY = Math.round(h * 9 * m.bounce);
        const squash = m.bounce > 0.08 && ballY === 0;
        run.style.setProperty('--dog-bob', String(bob));
        run.style.setProperty('--ball-y', String(ballY));
        run.style.setProperty('--ball-sx', squash ? '1.15' : '1');
        run.style.setProperty('--ball-sy', squash ? '0.8' : '1');
        run.style.setProperty('--ball-lead', String(2 + Math.round(4 * m.run)));   // 跑越快球滾越前面，永遠追不到
        run.style.setProperty('--shadow', (1 - (ballY / 9) * 0.6).toFixed(2));
        if (m.run > 0.005 || m.bounce > 0.005) alive = true;
      }
      motionRaf = alive ? requestAnimationFrame(stepMotion) : 0;
      if (!alive) lastT = 0;
    };
    const updateDogs = () => {
      for (const run of dogs) {
        if (reduce) {
          run.style.setProperty('--dog-p', '0.5');
          continue;
        }
        const r = run.getBoundingClientRect();
        const vw = document.documentElement.clientWidth;
        const at = (left: number) => (vw - left) / (vw + r.width);
        // 捲到底時這格的位置（格子往左移的距離 = 剩下還能捲的距離）
        const end = Math.min(1, at(r.left - (maxLeft() - track.scrollLeft)));
        // 狗在 92% 就要整隻跑出右緣：平滑捲動停下時常差一兩個像素到不了底，不留餘裕尾巴會卡在格子裡
        const p = Math.min(Math.max(at(r.left) / Math.max(end, 0.01) / 0.92, 0), 1);
        run.style.setProperty('--dog-p', p.toFixed(4));
        const m = motion.get(run) ?? { p, dist: 0, phase: 0, ballPhase: 0, run: 0, bounce: 0 };
        // 狗實際走的距離（畫面像素）：進度差 × 可移動的寬度（格子寬 + 一隻狗寬，從左外跑到右外）
        const dogW = run.querySelector<HTMLElement>('.dogrun__dog')?.getBoundingClientRect().width || 0;
        m.dist += Math.abs(p - m.p) * (r.width + dogW);
        m.p = p;
        motion.set(run, m);
        if (m.dist > 0.5 && !motionRaf) motionRaf = requestAnimationFrame(stepMotion);
      }
    };
    if (dogs.length) {
      track.addEventListener('scroll', updateDogs, { passive: true });
      window.addEventListener('resize', updateDogs);
      updateDogs();
    }

    // 照片格黃金比例：量照片那格的實際高度，把欄寬設成高 × φ（說明見 .col--photo）。
    // 用比例換算而不是直接寫像素，所以不受目前縮放倍率影響；縮放時寬高同比例變，不會反覆重設。手機不套用。
    const photoCol = document.getElementById('photo-col');
    const photoPanel = photoCol?.querySelector<HTMLElement>('.panel');
    const narrow = window.matchMedia('(width <= 52rem)');
    const PHI = 1.618;
    const fitPhoto = () => {
      if (!photoCol || !photoPanel) return;
      if (narrow.matches) {
        photoCol.style.removeProperty('width');
        photoCol.style.removeProperty('aspect-ratio');
        return;
      }
      // 改了欄寬，研究方向那格會重新換行、照片格的高跟著變，所以當場重量幾次直到穩定
      for (let n = 0; n < 6; n++) {
        const colW = photoCol.getBoundingClientRect().width;
        const want = photoPanel.getBoundingClientRect().height * PHI;
        if (colW === 0 || Math.abs(want - colW) < 0.5) return;
        const cssW = parseFloat(getComputedStyle(photoCol).width);
        photoCol.style.aspectRatio = 'auto';
        photoCol.style.width = `${cssW * (want / colW)}px`;
      }
    };
    if (photoCol && photoPanel) {
      // 欄寬改變會讓研究方向那格換行、照片格的高跟著變，所以持續觀察直到穩定
      new ResizeObserver(() => requestAnimationFrame(fitPhoto)).observe(photoPanel);
      narrow.addEventListener('change', fitPhoto);
      window.addEventListener('resize', fitPhoto);
      // 字體載入後文字寬度會變，研究方向那格可能換行不同
      document.fonts?.ready.then(fitPhoto);
      fitPhoto();
    }

    // 給頂部波形捲動軸用：拖曳時也走同一套平滑補間，才會順順地跟著動
    (window as unknown as { trackGlide: (left: number) => void }).trackGlide = (left: number) => {
      target = Math.min(Math.max(left, 0), maxLeft());
      if (reduce) track.scrollLeft = target;
      else if (!raf) raf = requestAnimationFrame(step);
    };

    // 觸控滑動、鍵盤等其他方式移動時，同步目標值
    track.addEventListener(
      'scroll',
      () => {
        if (!raf) target = track.scrollLeft;
      },
      { passive: true }
    );

    window.addEventListener(
      'wheel',
      (e) => {
        if (e.ctrlKey) return; // 保留觸控板縮放
        // 本來就是橫向手勢（觸控板左右滑）就交給瀏覽器
        if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;

        // 格子內容自己還能上下捲的話，先讓它捲
        const inner = (e.target as HTMLElement).closest?.('.panel__body') as HTMLElement | null;
        if (inner && inner.scrollHeight > inner.clientHeight + 1) {
          const atTop = inner.scrollTop <= 0 && e.deltaY < 0;
          const atBottom = inner.scrollTop + inner.clientHeight >= inner.scrollHeight - 1 && e.deltaY > 0;
          if (!atTop && !atBottom) return;
        }

        e.preventDefault();
        // deltaMode 1 是「行」而不是像素（部分滑鼠與 Firefox）
        const delta = e.deltaMode === 1 ? e.deltaY * 40 : e.deltaY;
        target = Math.min(Math.max(target + delta, 0), maxLeft());

        if (reduce) {
          track.scrollLeft = target;
        } else if (!raf) {
          raf = requestAnimationFrame(step);
        }
      },
      { passive: false }
    );

    // 鍵盤：方向鍵、PageUp/PageDown、Home/End 也能左右移動
    window.addEventListener('keydown', (e) => {
      const el = e.target as HTMLElement;
      if (el.closest('input, textarea, [contenteditable], .scrub')) return;
      const page = track.clientWidth * 0.8;
      const map: Record<string, number> = {
        ArrowRight: 120,
        ArrowDown: 120,
        ArrowLeft: -120,
        ArrowUp: -120,
        PageDown: page,
        ' ': page,
        PageUp: -page,
      };
      if (e.key === 'Home') target = 0;
      else if (e.key === 'End') target = maxLeft();
      else if (e.key in map) target = Math.min(Math.max(target + map[e.key], 0), maxLeft());
      else return;
      e.preventDefault();
      if (reduce) track.scrollLeft = target;
      else if (!raf) raf = requestAnimationFrame(step);
    });

    // 閱讀紀錄：點這一格（不是點論文連結）才展開／收合
    const readingCol = document.getElementById('reading-col');
    const readingBtn = readingCol?.querySelector<HTMLButtonElement>('.reading__toggle');
    if (readingCol && readingBtn && !readingBtn.disabled) {
      const setOpen = (open: boolean) => {
        readingCol.dataset.expanded = String(open);
        readingBtn.setAttribute('aria-expanded', String(open));
        // 展開動畫結束後再判斷一次
        window.setTimeout(checkMore, 700);
        checkMore();
      };
      const readingPanel = readingCol.querySelector<HTMLElement>('.panel');
      const list = readingCol.querySelector<HTMLElement>('.list');
      const checkMore = () => {
        if (!list) return;
        const hidden = readingCol.dataset.expanded !== 'true' && list.scrollHeight > list.clientHeight + 1;
        readingCol.dataset.more = String(hidden);
      };
      checkMore();
      window.addEventListener('resize', checkMore);
      new ResizeObserver(checkMore).observe(readingCol);
      readingPanel?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;
        setOpen(readingCol.dataset.expanded !== 'true');
      });
      readingCol.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && readingCol.dataset.expanded === 'true') {
          setOpen(false);
          readingBtn.focus();
        }
      });
      if (readingPanel) readingPanel.style.cursor = 'pointer';
    }

    // 已完成的格子：內容放不下時可以點開（往下展開、同欄其他格收起），再點一次或按 Esc 收合
    document.querySelectorAll<HTMLElement>('.fold').forEach((fold) => {
      const panel = fold.closest<HTMLElement>('.panel');
      const col = panel?.parentElement;
      const body = fold.querySelector<HTMLElement>('.fold__body');
      const btn = fold.querySelector<HTMLButtonElement>('.fold__toggle');
      if (!panel || !col || !body || !btn) return;
      const check = () => {
        const open = panel.dataset.open === 'true';
        const more = !open && body.scrollHeight > body.clientHeight + 1;
        fold.dataset.more = String(more);
        btn.disabled = !(more || open);
        panel.style.cursor = more || open ? 'pointer' : '';
      };
      const setOpen = (open: boolean) => {
        panel.dataset.open = String(open);
        col.dataset.folding = String(open);
        btn.setAttribute('aria-expanded', String(open));
        check();
        window.setTimeout(check, 700); // 展開動畫結束後再量一次
      };
      check();
      document.fonts?.ready.then(check);
      new ResizeObserver(check).observe(panel);
      panel.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a') || btn.disabled) return;
        setOpen(panel.dataset.open !== 'true');
      });
      panel.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && panel.dataset.open === 'true') {
          setOpen(false);
          btn.focus({ preventScroll: true });
        }
      });
    });

    // 「往右看進行中的工作」平滑捲到主要計畫
    document.querySelectorAll<HTMLAnchorElement>('a[href="#work"]').forEach((a) => {
      a.addEventListener('click', (e) => {
        const el = document.getElementById('work');
        if (!el) return;
        e.preventDefault();
        const col = el.closest('.col') as HTMLElement | null;
        const gutter = parseFloat(getComputedStyle(track).paddingLeft) || 0;
        target = Math.min(Math.max((col ?? el).offsetLeft - gutter, 0), maxLeft());
        if (reduce) track.scrollLeft = target;
        else if (!raf) raf = requestAnimationFrame(step);
      });
    });
  }
</script>
