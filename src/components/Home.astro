---
/**
 * 首頁：橫向軌道。整頁左右移動，不上下捲（使用者指定，參考 rauno.me）。
 *
 * 軌道由「欄」組成，每欄裝一到兩格，欄寬刻意不同。
 * 滑鼠滾輪的上下會被轉成左右；觸控板與觸控螢幕本來就能橫向滑。
 *
 * 顏色規則（使用者指定，見 MAINTENANCE.md）：
 *   藍色 = 研究方向、現在的主要計畫（WORK 裡 primary: true 的那一筆）、聯絡。
 *   其他專題、side project、已完成的一律白色。
 */
import TopBar from './TopBar.astro';
import Panel from './Panel.astro';
import PastedPhoto from './PastedPhoto.astro';
import dog from '../assets/dog.png';
import ball from '../assets/ball.png';
import { CONTACT, EDUCATION, READING, STRINGS, WORK, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = STRINGS[locale];
const en = locale === 'en';

const primary = WORK.filter((w) => w.status === 'active' && w.primary);
const sideActive = WORK.filter((w) => w.status === 'active' && !w.primary);
const closed = WORK.filter((w) => w.status === 'closed');

/* 白色工作欄。每欄兩格（使用者指定）：
   第一欄 = 其他進行中 + 最新一筆已完成；之後的已完成兩筆一欄，單數時補一格空白，欄底才不會凹一個洞。 */
type WorkCell =
  | { kind: 'side'; entry: (typeof WORK)[number]; grow: number }
  | { kind: 'closed'; entry: (typeof WORK)[number]; grow: number }
  | { kind: 'filler'; grow: number };

const workCols: Array<{ cls: string; cells: WorkCell[] }> = [
  {
    cls: 'col--work',
    cells: [
      ...sideActive.map((entry) => ({ kind: 'side' as const, entry, grow: 0 })),
      ...closed.slice(0, 1).map((entry) => ({ kind: 'closed' as const, entry, grow: 1.4 })),
    ],
  },
];
for (let i = 1; i < closed.length; i += 2) {
  const pair = closed.slice(i, i + 2);
  workCols.push({
    cls: 'col--closed',
    cells:
      pair.length === 2
        ? pair.map((entry) => ({ kind: 'closed' as const, entry, grow: entry.fit ? 0 : 1 })) // fit：貼合內容、完整顯示
        : [
            { kind: 'closed', entry: pair[0], grow: 0 },
            { kind: 'filler', grow: 1 },
          ],
  });
}

const L = {
  affiliation: en ? 'affiliation' : '所屬',
  lab: en ? 'lab' : '實驗室',
  status: en ? 'status' : '狀態',
  source: en ? 'source' : '出處',
  repo: en ? 'code' : '程式碼',
  authors: en ? 'authors' : '作者',
  entries: en ? 'entries' : '計數',
  total: en ? 'total' : '總計',
  read: en ? 'read' : '讀完',
  reading: en ? 'reading' : '在讀',
  span: en ? 'published' : '發表年份',
  expand: en ? 'show all' : '展開全部',
  collapse: en ? 'collapse' : '收合',
  education: en ? 'Education' : '教育背景',
  current: en ? 'current' : '就讀中',
  progress: en ? 'progress' : '進度',
  state: en
    ? { done: 'done', now: 'now', next: 'next' }
    : { done: '完成', now: '進行中', next: '接下來' },
};


const photoAlt = en
  ? 'Mirror selfie of LI, CHIA-CHUN (BEDO) in a white linen shirt and grey pinstripe trousers.'
  : '李嘉峻的鏡子自拍，白色亞麻襯衫、灰色細條紋西裝褲。';
---

<TopBar locale={locale} switchLabel={t.langSwitchLabel} scrubberLabel={t.scrubberLabel} />
<a class="skip-link" href="#main">{t.skipToContent}</a>

<main id="main" class="track-wrap">
  <div class="track" id="track" tabindex="-1">
    {/* ---- 欄 1：自我介紹 ---- */}
    <div class="col col--intro" id="intro-col">
      <Panel>
        <span class="disc" aria-hidden="true"></span>
        <div class="intro-stack">
          <div class="mark">
            <h1 class="mark__name">{t.intro.name}</h1>
            <p class="mark__sub">
              <span class="mark__formal">{t.intro.formal}</span>
              <span class="mark__rule" aria-hidden="true"></span>
              <span class="mark__alias">{t.intro.alias}</span>
            </p>
          </div>
          <a class="jump" href="#work">
            <span>{t.jumpAction}</span>
            <svg class="jump__arrow" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
              <path d="M1 7h12M8.5 2.5 13 7l-4.5 4.5" />
            </svg>
          </a>
        </div>
      </Panel>
    </div>

    {/* ---- 欄 2：照片（白底填滿空間，照片依原比例靠左、右邊暫時留空）+ 研究方向（壓扁、貼齊欄底） ---- */}
    <div class="col col--photo" id="photo-col">
      <Panel bleed grow={1}>
        <div class="photocell">
          <PastedPhoto alt={photoAlt} />
          <section class="edu" aria-label={L.education}>
            <h2 class="edu__head">{L.education}</h2>
            <ol class="edu__list">
              {
                EDUCATION.map((e) => (
                  <li class="edu__item">
                    <span class="mono edu__level">
                      {e.level[locale]}
                      {(e.period || e.current) && <span class="edu__period">{e.period ?? L.current}</span>}
                    </span>
                    <span class="edu__school">{e.school[locale]}</span>
                    {e.department && <span class="edu__program">{e.department[locale]}</span>}
                  </li>
                ))
              }
            </ol>
          </section>
        </div>
      </Panel>
      <Panel grow={0} compact>
        <h2 class="h h--line">{t.field}</h2>
        <dl class="fields fields--tight">
          <div class="fields__row">
            <dt class="tag">{L.affiliation}</dt>
            <dd class="fields__val">{t.affiliation}</dd>
          </div>
          <div class="fields__row">
            <dt class="tag">{L.lab}</dt>
            <dd class="fields__val">
              <a href={t.lab.href} rel="noopener noreferrer" target="_blank">{t.lab.label}</a>
            </dd>
          </div>
        </dl>
      </Panel>
    </div>

    {/* ---- 欄 3：現在的主要計畫（藍） ---- */}
    {
      primary.map((entry, i) => (
        <div class="col col--primary">
          <Panel accent id={i === 0 ? 'work' : undefined}>
            <h2 class="h h--lg">{entry.title[locale]}</h2>
            {entry.summary[locale] && <p class="body">{entry.summary[locale]}</p>}
            <dl class="fields fields--row">
              <div class="fields__row">
                <dt class="tag">{L.status}</dt>
                <dd class="mono fields__val fields__val--mono">{t.statusLabel.active}</dd>
              </div>
              {entry.source && (
                <div class="fields__row">
                  <dt class="tag">{L.source}</dt>
                  <dd class="fields__val">
                    <a href={entry.source.href} rel="noopener noreferrer" target="_blank">{entry.source.label}</a>
                  </dd>
                </div>
              )}
            </dl>
            {entry.progress && (
              <div class="progress">
                <p class="tag progress__head">
                  {L.progress} · <span class="mono">{entry.progress.asOf}</span>
                </p>
                <ol class="progress__list">
                  {entry.progress.items.map((item) => (
                    <li class="progress__item" data-state={item.state}>
                      <span class="mono progress__state">{L.state[item.state]}</span>
                      <span>{item.text[locale]}</span>
                    </li>
                  ))}
                </ol>
              </div>
            )}
          </Panel>
        </div>
      ))
    }

    {/* ---- 欄 4 起：其他進行中 + 已完成（白），每欄兩格，單數補空白格 ---- */}
    {
      workCols.map((col) => (
        <div class={`col ${col.cls}`}>
          {col.cells.map((cell, i) =>
            cell.kind === 'filler' ? (
              <Panel filler grow={cell.grow}>
                {/* 像素黃金獵犬：原圖 src/assets/dog-source.png（使用者提供），去背並還原成 35×34 像素格。
                    位置跟著這格在畫面上的位置反向移動，見下方腳本的 updateDogs。 */}
                <div class="dogrun">
                  <span class="dogrun__shadow"></span>
                  <img class="dogrun__ball" src={ball.src} width={ball.width} height={ball.height} alt="" decoding="async" />
                  <img class="dogrun__dog" src={dog.src} width={dog.width} height={dog.height} alt="" decoding="async" />
                </div>
              </Panel>
            ) : cell.kind === 'side' ? (
              <Panel grow={cell.grow} id={primary.length === 0 && i === 0 ? 'work' : undefined}>
                <h2 class="h">{cell.entry.title[locale]}</h2>
                {cell.entry.summary[locale] && <p class="body body--sm">{cell.entry.summary[locale]}</p>}
                <dl class="fields">
                  <div class="fields__row">
                    <dt class="tag">{L.status}</dt>
                    <dd class="mono fields__val fields__val--mono">{t.statusLabel.active}</dd>
                  </div>
                </dl>
              </Panel>
            ) : (
              <Panel closed grow={cell.grow}>
                {/* 放不下的內容先淡出並顯示「⋯」，點這一格往下展開（同閱讀紀錄），見下方腳本的 fold */}
                <div class="fold" data-more="false" data-fit={cell.entry.fit ? 'true' : undefined}>
                <h2 class="h fold__title">
                  <button class="fold__toggle" type="button" aria-expanded="false" aria-controls={`fold-${cell.entry.id}`} disabled>
                    <span>{cell.entry.title[locale]}</span>
                    <span class="mono fold__hint" aria-hidden="true">
                      <span class="fold__hint-open">{L.expand} ↓</span>
                      <span class="fold__hint-close">{L.collapse} ↑</span>
                    </span>
                  </button>
                </h2>
                <div class="fold__body" id={`fold-${cell.entry.id}`}>
                {cell.entry.summary[locale] && <p class="body body--sm">{cell.entry.summary[locale]}</p>}
                {cell.entry.details?.map((d) => (
                  <section class="fold__section">
                    <h3 class="fold__h">{d.heading[locale]}</h3>
                    <p class="body body--sm">{d.body[locale]}</p>
                  </section>
                ))}
                {/* 不標「已完成」：灰底虛線框本身就說明了（使用者要求，寫出來代表設計失敗） */}
                <dl class="fields">
                  {cell.entry.authors && (
                    <div class="fields__row">
                      <dt class="tag">{L.authors}</dt>
                      <dd class="fields__val">{cell.entry.authors}</dd>
                    </div>
                  )}
                  {cell.entry.repo && (
                    <div class="fields__row">
                      <dt class="tag">{L.repo}</dt>
                      <dd class="fields__val">
                        <a href={cell.entry.repo.href} rel="noopener noreferrer" target="_blank">{cell.entry.repo.label}</a>
                      </dd>
                    </div>
                  )}
                </dl>
                </div>
                <p class="mono fold__more" aria-hidden="true">⋯</p>
                </div>
              </Panel>
            )
          )}
        </div>
      ))
    }

    {/* ---- 欄 5：閱讀紀錄（上）+ 聯絡（下） ----
         閱讀紀錄收合時列出論文標題（每篇一行，放不下就淡出並顯示「⋯」）；點這一格才往下展開（蓋過下面的聯絡格，清單在格內上下捲），再點一次或按 Esc 收合。
         滑鼠移上去只是跟其他格一樣稍微放大，不會展開。 */}
    <div
      class="col col--reading"
      id="reading-col"
      data-expanded="false"
    >
      <Panel grow={1}>
        <div class="readingstack">
        <button
          class="reading__toggle"
          type="button"
          aria-expanded="false"
          aria-controls="reading-list"
          disabled={READING.length === 0}
        >
          <span class="reading__titlerow">
            <span class="h reading__title">{t.sections.reading}</span>
            <span class="reading__count">
              <span class="tag">{L.total}</span>
              <span class="stats__num">{READING.length}</span>
            </span>
          </span>
          {READING.length > 0 && (
            <span class="mono reading__hint">
              <span class="reading__hint-open">{L.expand} ↓</span>
              <span class="reading__hint-close">{L.collapse} ↑</span>
            </span>
          )}
        </button>


        {
          READING.length === 0 ? (
            <p class="body body--sm">{t.readingEmpty}</p>
          ) : (
            <ol class="list" id="reading-list">
              {READING.map((r) => (
                <li class="list__item">
                  <a href={r.href} rel="noopener noreferrer" target="_blank">{r.title}</a>
                  <span class="mono list__meta">{r.authors} · {r.venue} · {r.year}</span>
                </li>
              ))}
            </ol>
          )
        }
        <p class="mono reading__more" aria-hidden="true">⋯</p>
        </div>
      </Panel>

      {/* 聯絡（藍），與閱讀紀錄同一欄 */}
      <Panel accent grow={0}>
        <h2 class="h">{t.sections.contact}</h2>
        <p class="body body--sm">{t.contactIntro}</p>
        <ul class="links">
          {
            CONTACT.map((c) => (
              <li class="links__row">
                <span class="tag">{c.label}</span>
                <a
                  class="links__val"
                  href={c.href}
                  rel={c.href.startsWith('mailto:') ? undefined : 'me noopener noreferrer'}
                  target={c.href.startsWith('mailto:') ? undefined : '_blank'}
                >
                  {c.value}
                </a>
              </li>
            ))
          }
        </ul>
      </Panel>
    </div>

    {/* ---- 軌道終點 ---- */}
    <div class="col col--end">
      <a class="mono end__repo" href="https://github.com/acheeeee/acheeeee.github.io">acheeeee.github.io</a>
    </div>
  </div>
</main>

<style>
  /* ==========================================================
     橫向軌道
     ========================================================== */
  .track-wrap {
    flex: 1;
    min-height: 0;
  }

  .track {
    --u: clamp(13rem, 17vw, 19rem);
    display: flex;
    gap: var(--gap);
    height: 100%;
    /* 使用者要求：格子高度約為原本的 70%，上下各留 15% 空白。
       這段空白同時讓 hover 放大的格子不會被切掉。 */
    --bar-h: 5rem;
    /* 使用者要求格子在「整個視窗」上下置中，而且最左邊要能完整放大到 1.2 倍：
       放大時格子上下各長 10%，上面那段留白（扣掉半個頂部列）必須裝得下這 10%。
       一般螢幕用 15% 留白就夠；矮螢幕（例如 1280×720）改用第二項，格子會壓矮一點換回置中與放大（使用者選的）。 */
    --pad-y: max(
      calc((100dvh - var(--bar-h)) * 0.15),
      calc(((100dvh - var(--bar-h)) * 0.1 + var(--bar-h) / 2 + 0.25rem) / 1.2),
      /* 使用者要求方塊「矮胖、不要立著」：又高又窄的視窗裡，格子高度也受寬度限制——
         第一格（黃金比例）放大 1.2 倍後仍要放得進螢幕寬，1.9416 = 1.618 × 1.2。多出的高度變成上下留白。 */
      calc((100dvh - var(--bar-h) - (100vw - 2 * var(--gutter)) / 1.9416) / 2)
    );
    /* 上面少半個頂部列、下面多半個，格子中心就在視窗中心，高度不變 */
    --pad-top: calc(var(--pad-y) - var(--bar-h) / 2);
    padding-top: var(--pad-top);
    padding-bottom: calc(var(--pad-y) * 2 - var(--pad-top));
    padding-inline: var(--gutter);
    overflow-x: auto;
    overflow-y: hidden;
    /* 桌機不吸附：吸附會把滑鼠滾輪每一格的小位移拉回原位，看起來像滾不動。
       （這個坑踩過一次。）手機才吸附，見下方窄螢幕區塊。 */
    scroll-padding-inline: var(--gutter);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track:focus {
    outline: none;
  }

  .col {
    flex: none;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    min-height: 0;
    scroll-snap-align: start;
  }

  /* 第一格是黃金比例（使用者要求）：高度照原本（欄高），寬 = 高 × φ。
     用 aspect-ratio 讓寬度跟著高度走；窄視窗時不超過一個螢幕寬。 */
  .col--intro {
    aspect-ratio: 1.618 / 1;
    max-width: calc(100vw - 2 * var(--gutter));
  }

  /* 全部格子一起縮放：頁面在最左邊時所有欄放大（--track-zoom 最多 1.2），往右捲動時統一線性縮回 1。
     用 zoom 而不是 transform：zoom 會真的佔版面，格子之間不會互相蓋住。
     align-self: center 讓放大時上下平均長出去，吃掉軌道上下的留白。 */
  .track > .col {
    zoom: var(--track-zoom, 1);
    align-self: center;
    /* zoom 底下百分比高度會被抵銷（量過：視覺高度不變），所以要自己乘回去，上下才會一起長大 */
    height: calc(100% * var(--track-zoom, 1));
  }
  /* 照片格是黃金比例（使用者要求）：寬 = 照片那格的高 × 1.618。
     照片那格的高 = 欄高扣掉下面研究方向那格，那格的高度隨語言與換行變動，CSS 算不出來，
     所以由下方腳本量過再設欄寬；這裡的 aspect-ratio 只是腳本跑之前的近似值，避免載入時跳動。 */
  .col--photo {
    aspect-ratio: 1.3 / 1;
    max-width: calc(100vw - 2 * var(--gutter));
  }
  .col--primary { width: calc(var(--u) * 4.2); }
  .col--work { width: calc(var(--u) * 3.1); }
  .col--closed { width: calc(var(--u) * 2.6); }
  .col--reading { width: calc(var(--u) * 2.1); }

  /* ---- 照片格：照片靠左（尺寸由 PastedPhoto 依原圖比例算），學歷放進右邊留白 ---- */
  .photocell {
    position: absolute;
    inset: 0;
    container-type: size;
  }

  /* 照片寬（原圖比例 786×983，以格子內高度為準）——照片與教育背景共用這一個值。
     .frame 不是容器，所以照片裡的 cqw/cqh 也是相對 .photocell。 */
  :global(.photocell .frame),
  .edu {
    --photo-w: min(100cqw - 3rem, (100cqh - 3rem) / 1.251);
  }

  /* 教育背景的左緣 = 留白 + 照片寬 + 間距 */
  .edu {
    position: absolute;
    top: 1.5rem;
    bottom: 1.5rem;
    right: 1.5rem;
    left: calc(1.5rem + var(--photo-w) + 1.25rem);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* 「教育背景」是這塊的標題，跟其他格的標題同一個字級 */
  .edu__head {
    margin-bottom: var(--space-3);
    font-size: var(--text-xl);
    font-weight: 500;
  }

  .edu__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .edu__item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block: var(--space-3);
    border-top: var(--hairline) solid var(--edge);
  }

  .edu__school {
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.3;
  }

  .edu__program {
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--ink-muted);
  }

  .edu__level {
    display: flex;
    gap: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .edu__period {
    color: var(--accent);
  }

  /* 格子偏直（手機）時照片會吃掉整個寬度：改成照片約 42% 寬，學歷照樣放右邊 */
  @container (aspect-ratio < 1.15) {
    :global(.photocell .frame),
    .edu {
      --photo-w: min((100cqw - 3rem) * 0.42, (100cqh - 3rem) / 1.251);
    }

    .edu {
      left: calc(1.5rem + var(--photo-w) + 1rem);
    }

    .edu__school {
      font-size: var(--text-base);
    }

    .edu__program {
      font-size: var(--text-xs);
    }
  }

  @container (height < 23rem) {
    .edu__school {
      font-size: var(--text-base);
    }

    .edu__program {
      font-size: var(--text-xs);
    }

    .edu__item {
      padding-block: 0.45rem;
    }

    .edu__head {
      margin-bottom: 0.15rem;
      line-height: 1.05;
    }
  }

  /* 英文校名與系所比中文長很多，矮格子時英文版先退一級；中文維持大字 */
  @container (height < 23rem) {
    :global(html[lang='en']) .edu__school {
      font-size: var(--text-sm);
    }

    :global(html[lang='en']) .edu__program {
      font-size: var(--text-xs);
    }
  }

  @container (height < 21rem) {
    .edu__school {
      font-size: var(--text-base);
    }

    .edu__program {
      font-size: var(--text-xs);
    }

    .edu__item {
      gap: 0.15rem;
      padding-block: 0.4rem;
    }
  }

  .col--end {
    width: calc(var(--u) * 0.9);
    justify-content: flex-end;
    gap: var(--space-2);
    padding: var(--pad) 0;
  }

  .end__repo {
