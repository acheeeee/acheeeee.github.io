---
/**
 * 波形：整頁唯一的飽和色場，坐在電藍格板裡。
 *
 * 精準的 1px 墨線，每一欄一條，鏡像於零線 —— 這是真正的音訊編輯器畫波形的方式。
 * 不用模糊濾鏡、不用漸層。顏色全部由所在格板的 --on-accent 推出。
 *
 * 所有文字標籤走 HTML 絕對定位（百分比由幾何算出），不放進 SVG，
 * 這樣字級受控、可選取、螢幕閱讀器讀得到。
 */
import { buildWaveform } from '../lib/waveform';
import type { Segment } from '../lib/utterance';

interface Props {
  id: string;
  segments: Segment[];
  caption: string;
  alt: string;
  ampAxisLabel: string;
  timeAxisLabel: string;
  readout: { time: string; amp: string; segment: string; idle: string; help: string };
}

const { id, segments, caption, alt, ampAxisLabel, timeAxisLabel, readout } = Astro.props;
const w = buildWaveform(segments);

const pctX = (x: number) => `${(x / w.width) * 100}%`;

const segmentData = w.labels.map((l, i) => ({
  ipa: l.ipa,
  start: segments[i].start,
  end: segments[i].end,
  peak: w.peaks[i]?.peak ?? 0,
}));
---

<figure class="wave" aria-labelledby={`${id}-caption`}>
  <div
    class="wave__plot"
    id={`${id}-plot`}
    data-duration={w.duration}
    tabindex="0"
    aria-describedby={`${id}-help`}
  >
    <div class="wave__canvas">
      <svg
        class="wave__svg"
        viewBox={`0 0 ${w.width} ${w.height}`}
        preserveAspectRatio="none"
        role="img"
        aria-label={`${alt}（${ampAxisLabel} / ${timeAxisLabel}）`}
      >
        <g class="wave__trace">
          {
            w.columns.map((c) => (
              <line x1={c.x} x2={c.x} y1={c.top} y2={c.bottom} vector-effect="non-scaling-stroke" />
            ))
          }
        </g>
        <line
          class="wave__zero"
          x1="0"
          x2={w.width}
          y1={w.axisY}
          y2={w.axisY}
          vector-effect="non-scaling-stroke"
        />
        <g class="wave__bounds">
          {
            w.boundaries.map((b) => (
              <line
                x1={b.x}
                x2={b.x}
                y1="0"
                y2={w.height}
                vector-effect="non-scaling-stroke"
                data-onset={String(b.onset)}
              />
            ))
          }
        </g>
      </svg>

      <span class="wave__pen" aria-hidden="true"></span>
      <span class="wave__playhead" aria-hidden="true"></span>
    </div>

    <span class="sr-only" id={`${id}-help`}>{readout.help}</span>
  </div>

  <div class="wave__tier" aria-hidden="true">
    <div class="wave__row">
      {w.labels.map((l) => <span class="wave__ipa" style={`left:${pctX(l.x)}`}>{l.ipa}</span>)}
      {w.boundaries.map((b) => <span class="wave__stem" style={`left:${pctX(b.x)}`}></span>)}
    </div>
  </div>

  <figcaption class="wave__caption" id={`${id}-caption`}>
    <span class="wave__caption-text">{caption}</span>
    <output class="wave__readout" for={`${id}-plot`}>
      <span class="mono wave__idle">{readout.idle}</span>
      <span class="wave__live" hidden>
        <span class="mono wave__val"><span class="wave__key">{readout.time}</span><span data-readout="t">—</span></span>
        <span class="mono wave__val"><span class="wave__key">{readout.amp}</span><span data-readout="a">—</span></span>
        <span class="mono wave__val"><span class="wave__key">{readout.segment}</span><span class="wave__ipaval" data-readout="seg">—</span></span>
      </span>
    </output>
  </figcaption>

  <script type="application/json" data-segments set:html={JSON.stringify(segmentData)} />
</figure>

<style>
  .wave {
    --plot-pad: clamp(0.75rem, 1.4vw, 1.25rem);
    display: flex;
    flex-direction: column;
  }

  .wave__plot {
    position: relative;
    aspect-ratio: 1200 / 250;
    padding: var(--plot-pad);
    cursor: crosshair;
    touch-action: pan-y;
  }

  .wave__plot:focus-visible {
    outline: 2px solid var(--on-accent);
    outline-offset: -3px;
  }

  .wave__canvas {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .wave__svg {
    width: 100%;
    height: 100%;
  }

  /* 精準的 1px 墨線 */
  .wave__trace line {
    stroke: var(--on-accent);
    stroke-width: 1;
  }

  .wave__zero {
    stroke: color-mix(in oklab, var(--on-accent) 42%, transparent);
    stroke-width: 1;
  }

  .wave__bounds line {
    stroke: color-mix(in oklab, var(--on-accent) 34%, transparent);
    stroke-width: 1;
  }

  .wave__bounds line[data-onset='false'] {
    stroke: color-mix(in oklab, var(--on-accent) 62%, transparent);
  }

  .wave__pen,
  .wave__playhead {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 1px;
    background-color: var(--on-accent);
    pointer-events: none;
  }

  .wave__pen {
    opacity: 0;
  }

  .wave__playhead {
    opacity: 0;
    transition: opacity var(--clock) var(--ease);
  }

  .wave__playhead::before {
    content: '';
    position: absolute;
    top: 0;
    left: -2.5px;
    width: 6px;
    height: 6px;
    background-color: var(--on-accent);
  }

  .wave__plot[data-scrubbing='true'] .wave__playhead {
    opacity: 1;
  }

  /* 音標層 */
  .wave__tier {
    height: 1.75rem;
    padding-inline: var(--plot-pad);
  }

  .wave__row {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .wave__stem {
    position: absolute;
    top: 0;
    width: 1px;
    height: 0.3rem;
    background-color: color-mix(in oklab, var(--on-accent) 40%, transparent);
  }

  .wave__ipa {
    position: absolute;
    top: 0.5rem;
    translate: -50% 0;
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    color: color-mix(in oklab, var(--on-accent) 88%, transparent);
  }

  /* 圖說與讀值 */
  .wave__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding: 0 var(--plot-pad) var(--plot-pad);
  }

  .wave__caption-text {
    max-width: 52ch;
    font-size: var(--text-xs);
    color: color-mix(in oklab, var(--on-accent) 80%, transparent);
  }

  .wave__readout {
    min-height: 1.1rem;
  }

  .wave__idle {
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--on-accent) 62%, transparent);
  }

  .wave__live:not([hidden]) {
    display: flex;
    gap: var(--space-4);
  }

  .wave__val {
    display: inline-flex;
    gap: 0.4rem;
    font-size: var(--text-2xs);
    color: var(--on-accent);
  }

  .wave__key {
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--on-accent) 62%, transparent);
  }

  .wave__ipaval {
    font-family: var(--font-sans);
  }

  /* 入場：筆走過一次，墨線依序落下。共用 --clock。 */
  @media (prefers-reduced-motion: no-preference) {
    .wave__trace line {
      opacity: 0;
    }

    .wave[data-swept='true'] .wave__trace line {
      animation: ink calc(var(--clock) * 1.1) var(--ease) forwards;
      animation-delay: calc(var(--clock) * 2 * var(--col, 0));
    }

    .wave[data-swept='true'] .wave__pen {
      animation: pen calc(var(--clock) * 2.4) var(--ease) forwards;
    }
  }

  @keyframes ink {
    to {
      opacity: 1;
    }
  }

  @keyframes pen {
    0% {
      opacity: 0.85;
      transform: translateX(0);
    }
    90% {
      opacity: 0.5;
    }
    100% {
      opacity: 0;
      transform: translateX(var(--plot-width, 100%));
    }
  }

  @media (width <= 52rem) {
    .wave__plot {
      aspect-ratio: 1200 / 420;
    }
  }
</style>

<script>
  type SegmentDatum = { ipa: string; start: number; end: number; peak: number };

  function initWaveform(figure: HTMLElement) {
    const plot = figure.querySelector<HTMLElement>('.wave__plot');
    const canvas = figure.querySelector<HTMLElement>('.wave__canvas');
    const playhead = figure.querySelector<HTMLElement>('.wave__playhead');
    const idle = figure.querySelector<HTMLElement>('.wave__idle');
    const live = figure.querySelector<HTMLElement>('.wave__live');
    const json = figure.querySelector<HTMLElement>('[data-segments]');
    if (!plot || !canvas || !playhead || !idle || !live || !json) return;

    const duration = Number(plot.dataset.duration) || 1;
    let segments: SegmentDatum[] = [];
    try {
      segments = JSON.parse(json.textContent || '[]');
    } catch {
      segments = [];
    }

    const out = {
      t: figure.querySelector<HTMLElement>('[data-readout="t"]'),
      a: figure.querySelector<HTMLElement>('[data-readout="a"]'),
      seg: figure.querySelector<HTMLElement>('[data-readout="seg"]'),
    };

    /** 音段區間右開，時間軸最末端要歸給最後一個音段 */
    const segmentAt = (t: number): SegmentDatum | null => {
      const hit = segments.find((s) => t >= s.start && t < s.end);
      if (hit) return hit;
      const last = segments[segments.length - 1];
      return last && t >= last.end ? last : null;
    };

    const write = (fraction: number) => {
      const box = canvas.getBoundingClientRect();
      const t = fraction * duration;
      playhead.style.transform = `translateX(${fraction * box.width}px)`;
      if (out.t) out.t.textContent = `${t.toFixed(3)} s`;
      const hit = segmentAt(t);
      if (out.a) out.a.textContent = hit ? hit.peak.toFixed(2) : '—';
      if (out.seg) out.seg.textContent = hit ? hit.ipa : '—';
    };

    const enter = () => {
      plot.dataset.scrubbing = 'true';
      idle.hidden = true;
      live.hidden = false;
    };

    const leave = () => {
      plot.dataset.scrubbing = 'false';
      idle.hidden = false;
      live.hidden = true;
    };

    let frame = 0;
    plot.addEventListener('pointerenter', enter);
    plot.addEventListener('pointerleave', leave);
    plot.addEventListener('pointermove', (event) => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const box = canvas.getBoundingClientRect();
        write(Math.min(Math.max((event.clientX - box.left) / box.width, 0), 1));
      });
    });

    // 鍵盤路徑
    let kx = 0;
    const clamp01 = (n: number) => Math.min(Math.max(n, 0), 1);

    plot.addEventListener('keydown', (event) => {
      const step = event.shiftKey ? 0.1 : 1 / 40;
      let handled = true;
      switch (event.key) {
        case 'ArrowRight':
          kx = clamp01(kx + step);
          break;
        case 'ArrowLeft':
          kx = clamp01(kx - step);
          break;
        case 'Home':
          kx = 0;
          break;
        case 'End':
          kx = 1;
          break;
        default:
          handled = false;
      }
      if (!handled) return;
      event.preventDefault();
      enter();
      write(kx);
    });

    plot.addEventListener('focus', () => {
      enter();
      write(kx);
    });
    plot.addEventListener('blur', leave);

    const sweep = () => {
      const lines = figure.querySelectorAll<SVGLineElement>('.wave__trace line');
      const total = lines.length || 1;
      lines.forEach((line, i) => line.style.setProperty('--col', String((i / total) * 0.9)));
      plot.style.setProperty('--plot-width', `${canvas.getBoundingClientRect().width}px`);
      figure.dataset.swept = 'true';
    };

    if (
      'IntersectionObserver' in window &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              sweep();
              observer.disconnect();
            }
          }
        },
        { threshold: 0.2 }
      );
      observer.observe(figure);
    } else {
      figure.dataset.swept = 'true';
    }
  }

  document.querySelectorAll<HTMLElement>('.wave').forEach(initWaveform);
</script>
