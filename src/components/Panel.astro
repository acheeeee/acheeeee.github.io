---
/**
 * 格板：格盤的一格。一格一個主題。
 *
 * 不在格子上標註「這格是什麼」——內容自己會說明，訪客看就懂。
 * 細節只剩四角的十字對位記號。
 *
 * 顏色規則（使用者指定，見 MAINTENANCE.md）：
 *   藍色 = 現在正在做的主要計畫、研究方向、聯絡。其他一律白色。
 */
interface Props {
  /** 電藍色場 */
  accent?: boolean;
  /** 已完成：邊緣虛線、內容降為中性 */
  closed?: boolean;
  /** 格內是否自行處理內距（照片需要滿版） */
  bleed?: boolean;
  /** 在所屬欄位裡的高度比例；0 代表高度由內容決定（用來貼齊欄底） */
  grow?: number;
  /** 較緊的內距，用在需要壓扁的格子 */
  compact?: boolean;
  id?: string;
}

const { accent = false, closed = false, bleed = false, grow = 1, compact = false, id } = Astro.props;
---

<section
  class="panel"
  id={id}
  data-accent={accent ? 'true' : undefined}
  data-closed={closed ? 'true' : undefined}
  data-bleed={bleed ? 'true' : undefined}
  data-compact={compact ? 'true' : undefined}
  style={grow === 0 ? 'flex: 0 0 auto' : `--grow:${grow}`}
>
  <span class="panel__cross" data-at="tl" aria-hidden="true"></span>
  <span class="panel__cross" data-at="tr" aria-hidden="true"></span>
  <span class="panel__cross" data-at="bl" aria-hidden="true"></span>
  <span class="panel__cross" data-at="br" aria-hidden="true"></span>
  <div class="panel__body">
    <slot />
  </div>
</section>

<style>
  .panel {
    position: relative;
    flex: var(--grow, 1) 1 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background-color: var(--panel);
    border: var(--hairline) solid var(--edge);
    overflow: hidden;
    transform-origin: center;
    transition:
      transform var(--clock-hover) var(--ease-spring),
      box-shadow var(--clock-hover) var(--ease),
      border-color var(--clock-hover) var(--ease);
  }

  /* 滑鼠在格子之間移動時明顯回應：放大、浮起、壓過鄰格 */
  .panel:hover {
    z-index: 2;
    border-color: var(--edge-strong);
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.28);
  }

  @media (prefers-reduced-motion: no-preference) {
    .panel:hover {
      transform: scale(1.035);
    }
  }

  .panel[data-accent='true'] {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .panel[data-accent='true']:hover {
    box-shadow: 0 18px 40px -16px rgba(27, 35, 255, 0.55);
  }

  .panel[data-accent='true'] :global(:focus-visible) {
    outline-color: var(--on-accent);
  }

  .panel[data-compact='true'] .panel__body {
    padding: 1.25rem 1.5rem;
  }

  .panel[data-closed='true'] {
    border-style: dashed;
    background-color: var(--panel-soft);
  }

  .panel__body {
    flex: 1;
    min-height: 0;
    padding: var(--pad);
    overflow-y: auto;
    scrollbar-width: none;
  }

  .panel__body::-webkit-scrollbar {
    display: none;
  }

  .panel[data-bleed='true'] .panel__body {
    padding: 0;
    overflow: hidden;
  }

  .panel__cross {
    position: absolute;
    z-index: 1;
    width: 7px;
    height: 7px;
    pointer-events: none;
  }

  .panel__cross::before,
  .panel__cross::after {
    content: '';
    position: absolute;
    background-color: var(--ink-mark);
  }

  .panel__cross::before {
    top: 3px;
    left: 0;
    width: 7px;
    height: 1px;
  }

  .panel__cross::after {
    top: 0;
    left: 3px;
    width: 1px;
    height: 7px;
  }

  .panel[data-accent='true'] .panel__cross::before,
  .panel[data-accent='true'] .panel__cross::after {
    background-color: color-mix(in oklab, var(--on-accent) 55%, transparent);
  }

  .panel__cross[data-at='tl'] { top: 6px; left: 6px; }
  .panel__cross[data-at='tr'] { top: 6px; right: 6px; }
  .panel__cross[data-at='bl'] { bottom: 6px; left: 6px; }
  .panel__cross[data-at='br'] { bottom: 6px; right: 6px; }
</style>
