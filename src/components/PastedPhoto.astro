---
/**
 * 照片。
 *
 * 原圖只有 778px 寬，所以顯示寬度上限鎖在 330px（2x 螢幕剛好打平）。
 * 不得插值放大 —— 見 PRODUCT.md 的解析度限制。
 */
import { Image } from 'astro:assets';
import portrait from '../assets/bedo-portrait.jpeg';

interface Props {
  alt: string;
}

const { alt } = Astro.props;
---

<div class="shot">
  <Image
    class="shot__img"
    src={portrait}
    alt={alt}
    widths={[195, 260, 330]}
    sizes="(max-width: 52rem) 42vw, 330px"
    loading="eager"
    fetchpriority="high"
  />
</div>

<style>
  .shot {
    position: relative;
    width: 100%;
    height: 100%;
    /* 固定比例裁切：原圖是 778×1052（3:4），直接放會把整列撐高，
       讓隔壁的自我介紹格下半截空掉。 */
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--panel-soft);
  }

  @media (width <= 52rem) {
    .shot {
      aspect-ratio: 4 / 5;
    }
  }

  .shot__img {
    width: 100%;
    height: 100%;
    /* 原圖 778×1052；格板比例不同時以頂部為準，臉不會被切掉 */
    object-fit: cover;
    object-position: 50% 16%;
    /* 不做灰階。原本想讓照片不跟電藍搶，但灰階人像讀起來像遺照，那比搶戲糟得多。 */
    transition: transform var(--clock) var(--ease);
  }

  @media (prefers-reduced-motion: no-preference) {
    .shot:hover .shot__img {
      transform: scale(1.015);
    }
  }
</style>
