---
/**
 * 照片：白底格子填滿欄位空間，照片依原圖比例（786×983）放在左邊，四周留白不貼邊。
 * 右邊暫時留空（使用者要先看空間多大再決定放什麼）。不裁切、不拉伸、不能捲動。
 *
 * 原圖只有 786px 寬，顯示寬度不得插值放大（見 PRODUCT.md）。
 */
import { Image } from 'astro:assets';
import portrait from '../assets/bedo-portrait.jpeg';

interface Props {
  alt: string;
}

const { alt } = Astro.props;
---

<div class="frame">
  <Image
    class="photo"
    src={portrait}
    alt={alt}
    widths={[260, 390, 600, 786]}
    sizes="(max-width: 52rem) 40vw, 300px"
    loading="eager"
    fetchpriority="high"
  />
</div>

<style>
  /* 格子內四周留白 1.5rem；照片以這塊區域為準，取「放得進去的最大原比例尺寸」，靠左上。
     原圖 786×983，高 ÷ 寬 = 1.251。用容器查詢算確定寬高，比例不會跑掉。 */
  .frame {
    position: absolute;
    inset: 1.5rem;
  }

  /* --photo-w 由外層容器（Home.astro 的 .photocell）定義，照片與旁邊的教育背景共用同一條公式。
     沒有外層定義時退回：以格子內高度為準。 */
  .photo {
    display: block;
    width: var(--photo-w, auto);
    height: calc(var(--photo-w, 0px) * 1.251);
    max-width: none;
    object-fit: cover;
    transition: transform var(--clock) var(--ease);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.panel:hover) .photo {
      transform: scale(1.015);
    }
  }
</style>
